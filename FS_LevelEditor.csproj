<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="LocalPaths.props" Condition="Exists('LocalPaths.props')" />

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>FS_LevelEditor</RootNamespace>
		<LangVersion>default</LangVersion>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>FS_LevelEditor</AssemblyName>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Configurations>Debug;Release;Visible T bonds;Release NON EXP;Release NO UNITY 6</Configurations>
		<NoStdLib>true</NoStdLib>
		
		<!-- Why did Charles make two separate properties that point to the exact same path? -->
		<GameManaged>$(FSPath)\Fractal_Space_Data\Managed</GameManaged>
		<GameScripts Condition="'$(GameScripts)' == ''">$(GameManaged)</GameScripts>
		<GameExe>$(FSPath)\Fractal_Space.exe</GameExe>
		
		<!-- Unity 6's engine DLLs are built against netstandard 2.1. Without this, Visual Studio / dotnet silently add
         .NET Framework's OWN netstandard 2.0 facade and the build fails with CS1705 ("uses netstandard 2.1.0.0 which
         has a higher version"). The game's netstandard.dll (2.1) is referenced below instead. -->
		<ImplicitlyExpandNETStandardFacades Condition="Exists('$(GameManaged)\netstandard.dll')">false</ImplicitlyExpandNETStandardFacades>
		
		<!-- Remove the net48 folder from the output path -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		
		<OutputPath>$(USERPROFILE)\AppData\LocalLow\Haze Games\Fractal Space MOD\Mods\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Remove="Il2Cpp\**" />
	  <None Remove="Il2Cpp\**" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="KeybindsList.txt" />
	  <None Remove="leveleditoricons" />
	  <None Remove="level_editor" />
	  <None Remove="level_editor_sprites" />
	  <None Remove="Translations\Translations.csv" />
	</ItemGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Visible T bonds|AnyCPU'">
