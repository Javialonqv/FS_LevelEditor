		<Message Text="Injecting build date: $(BuildDate)" Importance="high" />
		<ItemGroup>
			<BuildInfoFiles Include="BuildInfo.cs" />
		</ItemGroup>
		<WriteLinesToFile File="BuildInfo.cs" Lines="namespace FS_LevelEditor { public static class BuildInfo { public const string BuildDate = &quot;$(BuildDate)&quot;%3B } }" Overwrite="true" />
	</Target>
